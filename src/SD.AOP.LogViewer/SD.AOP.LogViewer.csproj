<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <Description>SD.Framework - 日志查看器</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="favicon.ico" />
    <None Update="Content\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Installers\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SD.Toolkits.AspNet" Version="4.0.2" />
    <PackageReference Include="SD.Toolkits.EasyUI" Version="1.0.1" />
    <PackageReference Include="SD.Toolkits.Mapper" Version="4.0.2" />
    <PackageReference Include="SD.Toolkits.Recursion" Version="4.0.2" />
    <PackageReference Include="SD.IOC.Core" Version="3.0.2" />
    <PackageReference Include="SD.IOC.Extension.NetCore" Version="3.0.2" />
    <PackageReference Include="SD.Infrastructure" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SD.AOP.Core\SD.AOP.Core.csproj" />
    <ProjectReference Include="..\SD.AOP.LogViewer.Repository\SD.AOP.LogViewer.Repository.csproj" />
    <ProjectReference Include="..\SD.AOP.LogViewer.Repository.SqlServer\SD.AOP.LogViewer.Repository.SqlServer.csproj" />
  </ItemGroup>
</Project>
